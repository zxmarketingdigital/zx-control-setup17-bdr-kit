# Dependências
dispatcher/node_modules/

# Sessão WhatsApp (nunca commitar)
dispatcher/whatsapp-session/

# Variáveis de ambiente (gerado pelo wizard, contém o token Apify)
dispatcher/.env
docs/comandos-diarios.md

# Tokens de API (nunca commitar)
pipeline/.meta_token
scripts/.instagram-session.json

# Pipeline — dados de leads (privados, não commitar). Só a pasta fica no git.
pipeline/*
!pipeline/.gitkeep

# Logs (o dispatcher gira o arquivo: dispatcher.log.1, .2, .3)
dispatcher/dispatcher.log
dispatcher/dispatcher.log.*

# Cópias de segurança que o wizard faz antes de sobrescrever (podem ter chave de API)
*.bak-*

# Config do wizard: setup/config.json tem o token da Apify em texto puro (o Claude apaga
# no fim da instalação); setup-config.json tem o token mascarado. Nenhum dos dois sobe.
setup/config.json
setup/setup-config.json

# Arquivos gerados pelo wizard (não commitar — regenerar com setup.js).
# O CLAUDE.md é versionado (stub que dispara o roteiro); o contexto do aluno vai em
# .claude/contexto-local.md, importado por ele.
.claude/contexto-local.md
.claude/skills/

# OS
.DS_Store
Thumbs.db
