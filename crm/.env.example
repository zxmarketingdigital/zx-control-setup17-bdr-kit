# Gerado automaticamente pelo wizard de instalação (node setup/setup.js --config ...)
# Não edite manualmente — re-rode o wizard se precisar alterar valores

CRM_PORT=3001

# Horário em que você aceita reunião (o modo automático só oferece e agenda
# dentro dele, em dia útil, e só em horário livre na sua agenda do Google).
MEETING_START_HOUR=9
MEETING_END_HOUR=18

# Evolution API (WhatsApp) — mesma instância usada pelo dispatcher/.env.
# Usada pela aba "Prospecção Fria" pra checar status e enviar
# respostas manuais direto da conversa.
EVOLUTION_API_URL=http://localhost:8080
EVOLUTION_API_KEY=your_api_key_here
EVOLUTION_INSTANCE=bdr-instance
